{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowManagedHooksOnly": true,
  "disableAutoMode": "disable",
  "extraKnownMarketplaces": {
    "rubi": {
      "source": {
        "source": "directory",
        "path": "/Library/Application Support/Rubi Home/claude-plugin"
      }
    }
  },
  "enabledPlugins": {
    "rubi-sisters@rubi": true
  },
  "permissions": {
    "allow": [
      "mcp__plugin_rubi-sisters_rubi__rubi_sisters",
      "mcp__plugin_rubi-sisters_rubi__rubi_inbox_status"
    ],
    "deny": [
      "Edit(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(.claude/**)",
      "Edit(//Library/Application Support/ClaudeCode/**)",
      "Edit(//usr/local/bin/rubi-home)",
      "Edit(//Library/Application Support/Rubi Home/**)",
      "Edit(~/.rubi-home/**)",
      "Edit(~/Library/Application Support/Rubi Home/**)",
      "Edit(~/Library/LaunchAgents/com.rubi-project.home.plist)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/rubi-home",
            "args": [
              "claude-hook"
            ],
            "timeout": 300,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/rubi-home",
            "args": [
              "claude-hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/rubi-home",
            "args": [
              "claude-hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/rubi-home",
            "args": [
              "claude-hook"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/local/bin/rubi-home",
            "args": [
              "claude-hook",
              "--wait"
            ],
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/rubi-home",
            "args": [
              "claude-hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "-c",
              "echo 'Rubi policy: settings changes during a session are not applied; restart Claude Code to load them.' >&2; exit 2"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}

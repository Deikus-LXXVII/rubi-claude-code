{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowManagedHooksOnly": true,
  "allowManagedPermissionRulesOnly": true,
  "disableAutoMode": "disable",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(.claude/**)",
      "Edit(//Library/Application Support/ClaudeCode/**)",
      "Edit(//usr/local/bin/rubi-home)",
      "Edit(~/.rubi-home/**)",
      "Edit(~/Library/Application Support/Rubi Home/**)",
      "Edit(~/Library/LaunchAgents/com.rubi-project.home.plist)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/rubi-home",
            "args": ["claude-hook"],
            "timeout": 300,
            "onFailure": "block"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": ["-c", "echo 'Rubi policy: settings changes during a session are not applied; restart Claude Code to load them.' >&2; exit 2"],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
